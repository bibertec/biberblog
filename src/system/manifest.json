{
  "name": "biberblog",
  "version": "1.3.1",
  "repository": "https://github.com/bibertec/biberblog",
  "files": [
    "app/api/editor/deployment/route.ts",
    "app/api/editor/image/upload/route.ts",
    ".github/workflows/biberblog.yml"
  ],
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@node-rs/argon2": "^2.2.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-list-item": "^3.31.3",
    "@tiptap/extension-ordered-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@vercel/blob": "^2.6.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@redux-devtools/extension": "^4.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "inquirer": "^14.2.2",
    "plop": "^4.0.5",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "predev": "npm run version:sync && npm run generate",
    "dev": "next dev",
    "prebuild": "npm run version:sync && npm run generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "transform:images": "node src/system/scripts/images/transform-images.mjs",
    "editor:set-password": "node src/system/scripts/auth/set-editor-password.ts",
    "setup": "node src/system/cli/bin/setup.ts",
    "system:update": "node src/system/cli/bin/update.ts",
    "system:status": "node src/system/cli/bin/status.ts",
    "generate": "node src/system/cli/bin/generate.ts",
    "version:sync": "node src/system/cli/bin/version.ts",
    "plop": "plop --plopfile src/system/cli/plopfile.ts --dest .",
    "module:create": "plop --plopfile src/system/cli/plopfile.ts --dest . module:create",
    "module:add-editable-field": "plop --plopfile src/system/cli/plopfile.ts --dest . module:add-editable-field",
    "module:remove-editable-field": "plop --plopfile src/system/cli/plopfile.ts --dest . module:remove-editable-field",
    "module:add-custom-field": "plop --plopfile src/system/cli/plopfile.ts --dest . module:add-custom-field",
    "module:remove-custom-field": "plop --plopfile src/system/cli/plopfile.ts --dest . module:remove-custom-field",
    "module:remove": "plop --plopfile src/system/cli/plopfile.ts --dest . module:remove",
    "page:add-module": "plop --plopfile src/system/cli/plopfile.ts --dest . page:add-module",
    "page:remove-module": "plop --plopfile src/system/cli/plopfile.ts --dest . page:remove-module",
    "page:add": "plop --plopfile src/system/cli/plopfile.ts --dest . page:add",
    "page:remove": "plop --plopfile src/system/cli/plopfile.ts --dest . page:remove"
  }
}
